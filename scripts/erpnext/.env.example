# Copy to scripts/erpnext/.env (gitignored) or export in the shell.
# Atlas reads these from process.env — they are NOT VITE_ secrets.
#
# ERPNext lives at D:\ERPNext (https://github.com/frappe/erpnext).
# Do not clone ERPNext into the Atlas repo.

ERPNEXT_URL=http://127.0.0.1:8000
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=MOCK ATLAS3 LLP
ERPNEXT_POSTING_ENABLED=false

# If your D:\ERPNext stack publishes another port, change ERPNEXT_URL.
# Reserved: Atlas 8080, CatBoost 8091. Do not put ERPNext on those.
